# Next.js and Clerk (Vercel Production environment)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supplied by `npx convex deploy` during the Vercel build
NEXT_PUBLIC_CONVEX_URL=

# Convex deployment environment
CLERK_JWT_ISSUER_DOMAIN=

# CI/Vercel deployment credential (never expose to the browser)
CONVEX_DEPLOY_KEY=
